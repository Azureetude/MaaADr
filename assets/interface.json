{
    "interface_version": 2,
    "name": "MaaADr",
    "icon": "./resource/logo.ico",
    "description": "基于全新架构的 龙脉R(AnaDos) 自动清体/兑换小助手",
    "contact": "QQ群: 1071729734",
    "license": "MIT",
    "welcome": "./resource/announcement/welcome.md",
    "github": "https://github.com/Azureetude/MAAADr",
    //"version": "0.0.1",
    "mirrorchyan_rid": "MaaADr",
    "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "Win32",
            "label": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "龍脈|Ana",
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        },
        {
            "name": "ADB",
            "label": "模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "official",
            "label": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "EX",
            "label": "龙の座",
            "description": "使用该资源包视为已阅读免责声明与风险提示",
            "path": [
                "./resource",
                "./resource/EX"
            ]
        }
    ],
    // 使用系统 PATH 中的 Python。
    "agent": {
        "child_exec": "python",
        "child_args": [
            "{PROJECT_DIR}/../agent/main.py",
            "-u"
        ]
    },
     "import": [
       "./resource/tasks/recognition_timeout.json",
       "./resource/tasks/opengame.json",
       "./resource/tasks/linkstart.json",
       "./resource/tasks/dailyexchange.json",
       "./resource/tasks/homepagess.json",
       "./resource/tasks/LatastSS_Clean_EX.json",
       "./resource/tasks/homepagess_EX.json",
       "./resource/tasks/getitem.json",
    //   "./resource/tasks/getitem_EX.json",
       "./resource/tasks/RestoreStamina.json",
       "./resource/tasks/mainstory_EX.json",
       "./resource/tasks/switchaccount.json",
       "./resource/tasks/Closegame.json"
    //   "./resource/tasks/keymousego.json",
    //   "./resource/tasks/replay.json"
     ]
}
